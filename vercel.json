{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api/:path*",
      "destination": "https://v2.mastertrader.co.in/api/:path*"
    },
    {
      "source": "/",
      "destination": "/page-html/home.html"
    },
    {
      "source": "/:page(blogs|markets|market-ai|disclaimer)",
      "destination": "/page-html/:page.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
